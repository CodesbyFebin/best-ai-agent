{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,graph-data.json}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(robots|llms|llms-full|security|humans)\\.txt",
      "dest": "/$1.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
