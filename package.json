{
  "name": "best-ai-agent",
  "private": true,
  "version": "0.1.0",
  "description": "India-first, evidence-backed AI agent discovery, comparison, pricing, and evaluation platform.",
  "type": "module",
  "keywords": [
    "ai-agents",
    "ai-agent",
    "ai-agent-directory",
    "agent-comparison",
    "mcp",
    "model-context-protocol",
    "india",
    "inr-pricing",
    "evidence-based",
    "canonical-routing",
    "ssr",
    "react",
    "express",
    "vite"
  ],
  "homepage": "https://bestaiagent.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodesbyFebin/best-ai-agent.git"
  },
  "bugs": {
    "url": "https://github.com/CodesbyFebin/best-ai-agent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx server.tsx",
    "build": "vite build && esbuild server.tsx --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test:evidence": "tsx scripts/verify-evidence.ts",
    "test:sitemap": "tsx scripts/verify-sitemaps.ts",
    "test:ssr": "tsx scripts/verify-ssr.ts",
    "test:ssr-hydration": "tsx scripts/verify-ssr-hydration.tsx",
    "test:graph": "tsx scripts/verify-graph.ts",
    "test:manifest": "tsx scripts/verify-manifest.ts",
    "test:production": "tsx scripts/verify-production.mjs",
    "test:ssr-runtime": "tsx scripts/verify-ssr-runtime.tsx",
    "test:scope-freeze": "tsx scripts/verify-scope-freeze.tsx",
    "check:quarantine": "tsx scripts/check-quarantine.ts",
    "generate:content": "tsx scripts/generate-content.tsx",
    "quarantine:enable": "ENABLE_LEGACY_MANIFEST=true npm run generate:content --",
    "content:deep": "tsx scripts/content/generate-deep-page.ts",
    "content:enrich": "tsx scripts/content/enrich-entity.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^4.82.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.4.21",
    "csv-parse": "^5.6.0",
    "esbuild": "^0.25.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3"
  }
}
