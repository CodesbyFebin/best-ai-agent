{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.tsx",
    "build": "vite build && esbuild server.tsx --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:evidence": "tsx scripts/verify-evidence.ts",
    "test:sitemap": "tsx scripts/verify-sitemaps.ts",
    "test:ssr": "tsx scripts/verify-ssr.ts",
    "test:ssr-hydration": "tsx scripts/verify-ssr-hydration.ts",
    "test:graph": "tsx scripts/verify-graph.ts",
    "test:manifest": "tsx scripts/verify-manifest.ts",
    "test:production": "tsx scripts/verify-production.mjs",
    "test:ssr-runtime": "tsx scripts/verify-ssr-runtime.tsx",
    "test:graph-integrity": "tsx scripts/verify-graph-integrity.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.4.21",
    "csv-parse": "^5.6.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
